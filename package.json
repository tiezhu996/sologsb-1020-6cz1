{
  "name": "sologsb-1020-archive-reconciliation",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode ssr",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "esbuild scripts/test-version.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-version.mjs --log-level=error && node node_modules/.cache/test-version.mjs",
    "test:dom": "npm run build && esbuild scripts/test-dom.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-dom.mjs --external:jsdom --log-level=error && node node_modules/.cache/test-dom.mjs"
  },
  "dependencies": {
    "@builder.io/qwik": "^1.20.1",
    "@qwik-ui/headless": "^0.7.7"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
